# Local dev mode (npm run dev)
RTSP_STREAM_PORT=8554
HOST_IP=change_me
CAMERAS_CONFIG=./cameras.yml

# Docker mode (docker compose up)
# macvlan parent interface: eth0 on both Raspberry Pi and Mac (OrbStack's VM uses eth0)
NETWORK_INTERFACE=eth0

# RTSP URLs for each camera — referenced by docker-compose.yml
# Channels 1 and 6 are offline on the DVR; active channels are 2,3,4,5,7,8
# CAM1_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=2...  # Patio
# CAM2_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=3...  # Front Garden
# CAM3_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=4...  # Side Garden
# CAM4_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=5...  # Back Garden
# CAM5_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=7...  # Driveway
# CAM6_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=8...  # Front of House
