# Local dev mode (npm run dev)
RTSP_STREAM_PORT=8554
HOST_IP=change_me
CAMERAS_CONFIG=./cameras.yml

# Docker mode (docker compose up)
# macvlan parent interface: eth0 on both Raspberry Pi and Mac (OrbStack's VM uses eth0)
NETWORK_INTERFACE=eth0

# RTSP URLs for each camera — referenced by docker-compose.yml
# CAM1_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=2...
# CAM2_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=3...
# CAM3_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=4...
# CAM4_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=5...
# CAM5_RTSP_URL=rtsp://admin:password@192.168.1.247:554/...channel=6...
